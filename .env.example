# vox — Environment Configuration

# -----------------------------------------------------------------------------
# Anthropic (planner + skill synthesizer)
# We use the limtok.net proxy, not console.anthropic.com directly.
# Both the Anthropic SDK and Claude Agent SDK honor ANTHROPIC_BASE_URL.
# -----------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://apis.limtok.net
ANTHROPIC_API_KEY=

# Models — set per workload.
#   Available: claude-opus-4-8, claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
#   Rough list pricing (input / output per Mtok): Opus ≈ $15 / $75 — Sonnet ≈ $3 / $15.
#
# Defaults below favor cost: Sonnet for the per-utterance planner and the
# per-frame vision-trigger checker (these dominate runtime spend), Opus for
# the synthesizer because skill creation is one-shot and quality compounds
# across every future invocation of the generated skill.
#
# To get max planning/trigger quality at higher cost, set both to claude-opus-4-7
# (or claude-opus-4-8). The vision-trigger checker is the single biggest knob:
# active scenes run a model call per non-deduped frame (~1 Hz).
PLANNER_MODEL=claude-sonnet-4-6
SYNTHESIZER_MODEL=claude-opus-4-7
TRIGGER_MODEL=claude-sonnet-4-6

# Skill synthesizer backend:
#   claude_agent_sdk (default) | cursor_sdk
SYNTHESIZER_BACKEND=claude_agent_sdk
# Used when SYNTHESIZER_BACKEND=cursor_sdk
# CURSOR_API_KEY=cursor_xxx
SYNTHESIZER_CURSOR_MODEL=auto

# Vision trigger checker backend: anthropic | bicv
#   anthropic — Claude via ANTHROPIC_* (uses TRIGGER_MODEL above)
#   bicv      — company OpenAI-compatible server (Qwen3-VL on BICV_Server_Model)
TRIGGER_BACKEND=anthropic

# BICV_Server_Model (OpenAI-compatible /v1/chat/completions)
# Used when TRIGGER_BACKEND=bicv
TRIGGER_BICV_BASE_URL=http://192.168.125.91:30080/v1/chat/completions
TRIGGER_BICV_MODEL=/huggingface/models/Qwen/Qwen3-VL-4B-Instruct
TRIGGER_BICV_MAX_TOKENS=128
# TRIGGER_BICV_API_KEY=
# TRIGGER_BICV_TIMEOUT_SEC=30

# -----------------------------------------------------------------------------
# ASR — FunASR local CPU inference (reused from vui)
# Model is auto-downloaded on first run from ModelScope.
# -----------------------------------------------------------------------------
FUNASR_OFFLINE_MODEL=paraformer-zh

# -----------------------------------------------------------------------------
# TTS — Volcano Engine OpenSpeech (reused from vui)
# -----------------------------------------------------------------------------
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_SECRET_KEY=
VOLC_TTS_VOICE_TYPE=zh_female_sajiaonvyou_moon_bigtts
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v1/tts
VOLC_TTS_CLUSTER=volcano_tts

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=5001

# -----------------------------------------------------------------------------
# Generic web search / fetch backbone (for synthesized skills)
# -----------------------------------------------------------------------------
# Optional: enables Google results via SerpAPI when provided.
SERPAPI_KEY=
# Shared fetch/search limits
WEB_FETCH_TIMEOUT_MS=25000
WEB_FETCH_MAX_BYTES=2097152
# Optional override for web fetch user-agent
WEB_FETCH_USER_AGENT=
# 0 = block localhost/private network fetches (recommended)
WEB_FETCH_ALLOW_PRIVATE=0
WEB_SEARCH_MAX_RESULTS=6

# -----------------------------------------------------------------------------
# China map routing / geocoding
# -----------------------------------------------------------------------------
# Gaode (AMap) Web Service key
AMAP_WEB_SERVICE_KEY=
# Optional compatibility alias for older skills
AMAP_API_KEY=
# Optional Baidu map AK (for fallback providers)
BAIDU_MAP_AK=
